{
  "name": "react-components-starter",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "A starter for creating a React component library.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/gugustinette/react-components-starter#readme",
  "bugs": {
    "url": "https://github.com/gugustinette/react-components-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gugustinette/react-components-starter.git"
  },
  "author": "Augustin Mercier <gugustinette@proton.me>",
  "funding": "https://github.com/sponsors/gugustinette",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "playground": "vite --config playground/vite.config.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19.1",
    "react-dom": "^18.3 || ^19.1"
  },
  "dependencies": {
    "react-compiler-runtime": "19.1.0-rc.3"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^7.4.0",
    "@sxzz/prettier-config": "^2.2.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.1",
    "happy-dom": "^17.6.3",
    "prettier": "^3.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.16.8",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@latest",
    "vitest": "^3.2.4"
  },
  "prettier": "@sxzz/prettier-config"
}
